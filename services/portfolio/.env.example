# Инициализация POSTGRES
POSTGRES_USER=admin
POSTGRES_PASSWORD=1q2w3e
POSTGRES_DB=database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

TZ=Europe/Moscow
PGTZ=Europe/Moscow

# Подключение к Postgres
DB_HOST=postgres
DB_NAME=database
DB_USER=admin
DB_PASSWORD=1q2w3e
DB_PORT=5432

# Настройки JWT:
JWT_SECRET_KEY=secret_key
JWT_ALGORITHM=HS256

# Настройка CORS
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,https://aledev.ru,https://www.aledev.ru
CORS_ALLOW_ORIGIN_REGEX=^https?://([a-z0-9-]+\.)?aledev\.ru$

# Обратная связь (SMTP Яндекс Почты)
# SMTP_PASSWORD — пароль приложения: id.yandex.ru → Безопасность → Пароли приложений → «Почта»
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=your-login@yandex.ru
SMTP_PASSWORD=
FEEDBACK_SENDER_NAME=AleDev
# Отправитель должен совпадать с SMTP_USER (или быть его алиасом); пусто — берётся SMTP_USER
FEEDBACK_SENDER=
# Куда приходят письма; пусто — на SMTP_USER
FEEDBACK_RECEIVER=

TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
FEEDBACK_MIN_FORM_FILL_SECONDS=2
